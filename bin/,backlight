#!/bin/bash

set -e

brightness=/sys/class/backlight/intel_backlight/brightness

if [ -f $brightness ]
then
    max="$(cat /sys/class/backlight/intel_backlight/max_brightness)"
    if [ "$1" = "up" ]
    then
        let b="$(cat $brightness) * 4 / 3"
        if (( $b > $max ))
        then
            b=$max
        fi
        echo "$b" > $brightness
    elif [ "$1" = "down" ]
    then
         let b="($(cat $brightness) * 3 / 4) + 1"
         echo "$b" > $brightness
    fi
    echo Brightness $(cat $brightness) / $max
else
    if [ -z "$1" ]
    then
        xbacklight
    elif  [ "$1" = "up" ]
    then
        xbacklight -inc 1
    else
        xbacklight -dec 1
    fi
fi
